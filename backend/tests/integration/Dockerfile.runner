FROM python:3.15-alpine AS builder

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /build

COPY pyproject.toml uv.lock ./
COPY backend/app backend/app
RUN uv sync --frozen --extra dev --no-editable --no-cache

FROM python:3.15-alpine

RUN apk add --no-cache \
    libjxl-tools \
    imagemagick imagemagick-heic imagemagick-jxl imagemagick-webp \
    exiftool \
    ffmpeg \
    curl \
    git

COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH=/workspace/backend

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Run as a non-root UID so pytest's own artifacts (.test-data/,
# .pytest_cache/, coverage.xml) written back through the -v bind mount
# don't end up root-owned on the host (harmless on ephemeral CI runners,
# but blocks cleanup on a persistent local checkout).
RUN adduser -D -u 1000 -s /bin/sh runner
USER runner

WORKDIR /workspace
